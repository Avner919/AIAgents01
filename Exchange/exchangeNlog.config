<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<configSections>
		<section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog"/>
	</configSections>
	<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          autoReload="true">

		<!-- enable asp.net core layout renderers -->
		<extensions>
			<add assembly="NLog.Web.AspNetCore"/>
		</extensions>

		<variable name="exchangeLogDirectory" value="C:\ProgramData\Russian.Post.EAS4\Espp\exchangeLogs"/>

		<!-- the targets to write to -->
		<targets>
			<!-- File Target for all log messages with basic details -->
			<target xsi:type="File" name="allfile"
                    fileName="${exchangeLogDirectory}\exchange-log.log"
                    archiveFileName="${exchangeLogDirectory}\exchange-log-{#}.zip"
                    archiveEvery="Day"
                    archiveNumbering="Date"
                    maxArchiveFiles="30"
                    archiveDateFormat="yyyy-MM-dd"
                    enableArchiveFileCompression="true"
                    encoding="utf-8"
                    layout="${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${uppercase:${level}}|${message} ${exception:format=tostring}${mdlc:item=hostid}" />

			<!-- Проводим архивацию логов каждый день. Также при превышении файла лога в 1Гб -->
			<target name="file" xsi:type="File"
                    layout="${longdate} ${logger} ${message}"
                    fileName="${exchangeLogDirectory}\exchange-log-${shortdate}.log"
                    archiveFileName="${exchangeLogDirectory}\logs\exchange-log-${shortdate}.log.gz"
                    archiveEvery="Day"
                    archiveNumbering="Date"
                    archiveAboveSize="1073741824"
                    maxArchiveFiles="20"
                    concurrentWrites="true"
                    keepFileOpen="false"
                    encoding="utf-8" />
		</targets>

		<!-- rules to map from logger name to target -->
		<rules>
			<!--All logs, including from Microsoft-->
			<logger name="*" minlevel="Info" writeTo="allfile" />

			<!--Output hosting lifetime messages to console target for faster startup detection -->
			<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="lifetimeConsole, ownFile-web" final="true" />

			<!--Skip non-critical Microsoft logs and so log only own logs-->
			<logger name="Microsoft.*" maxlevel="Info" final="true" />
			<!-- BlackHole -->

			<logger name="Microsoft.AspNetCore.DataProtection.*" maxlevel="Error" final="true" />

			<logger name="*" minlevel="Info" writeTo="ownFile-web" />
		</rules>
	</nlog>
</configuration>